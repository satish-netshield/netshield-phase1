import sqlite3
import os
import time
from datetime import datetime

BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DB_PATH = os.path.join(BASE_DIR, "netshield.db")

def save_to_db(timestamp, level, message):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()

    cursor.execute("""
        INSERT INTO incidents (timestamp, level, message)
        VALUES (?, ?, ?)
    """, (timestamp, level, message))

    conn.commit()
    conn.close()


def log_incident(timestamp, level, msg):
    print(level, msg)
    save_to_db(timestamp, level, msg)

